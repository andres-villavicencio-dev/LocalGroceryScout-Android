<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG-ONLY manifest overlay.

  Replaces the production networkSecurityConfig attribute with the debug
  variant (which permits cleartext HTTP for any host) so debug builds can
  talk to user-configured ollama instances on LAN addresses.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:networkSecurityConfig="@xml/network_security_config"
        tools:replace="android:networkSecurityConfig" />
</manifest>
